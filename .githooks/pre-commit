#!/bin/sh
# Pre-commit hook — validates code quality on dev and main branches
# Runs pnpm validate (lint + typecheck + build) before allowing commits

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Only gate commits to dev and main
if [ "$BRANCH" != "dev" ] && [ "$BRANCH" != "main" ]; then
  exit 0
fi

echo ""
echo "Running validation gate on $BRANCH branch..."
echo ""

pnpm validate
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "VALIDATION GATE FAIL: pnpm validate failed on $BRANCH branch"
  echo "Commit blocked. Fix the errors above before committing."
  echo "To skip (not recommended): git commit --no-verify"
  exit 1
fi

echo ""
echo "Validation passed. Proceeding with commit."
exit 0
