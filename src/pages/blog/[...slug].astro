---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { defaultLocale } from '@/i18n/config';
import { t } from '@/i18n/index';
import { siteBase } from '@/i18n/url';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('articles', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
};

const { slug } = Astro.params;
const target = `${siteBase()}/${defaultLocale}/blog/${slug}`;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t('redirect.title', defaultLocale)}</title>
    <meta http-equiv="refresh" content={`2;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>
      {t('redirect.toArticle', defaultLocale)}{' '}
      <a href={target}>{t('redirect.articleName', defaultLocale)}</a>…
    </p>
    <script define:vars={{ target }}>
      window.location.href = target;
    </script>
  </body>
</html>
