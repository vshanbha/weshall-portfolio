---
import { getStaticPathsHelper } from '@/i18n/paths-helper';
import PageLayout from '@/layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';
import { defaultLocale, type Locale } from '@/i18n/config';

export const getStaticPaths = getStaticPathsHelper;

// The ten commandments exist as one content entry per locale (see the
// collection's `locale` field). The "We shall …" imperative headings stay
// English in every variant; only the detail prose is translated. Locales
// without their own variant fall back to the English source.
const { lang } = Astro.params;
const locale = (lang as Locale) || defaultLocale;
const entries = await getCollection('philosophy');
const entry =
  entries.find((e) => e.data.locale === locale) ??
  entries.find((e) => e.data.locale === defaultLocale);
if (!entry) {
  throw new Error('Philosophy collection is empty: expected the ten commandments entry.');
}
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.description}>
  <section class="py-24 md:py-32">
    <div class="container mx-auto px-4 max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl font-display text-balance mb-4">
        {entry.data.title}
      </h1>
      {entry.data.description && (
        <p class="text-lg text-muted-foreground text-balance mb-10">{entry.data.description}</p>
      )}
      <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:font-bold prose-headings:text-xl prose-a:text-brand-600 hover:prose-a:text-brand-500 dark:prose-invert dark:prose-a:text-brand-400">
        <Content />
      </div>
    </div>
  </section>
</PageLayout>
