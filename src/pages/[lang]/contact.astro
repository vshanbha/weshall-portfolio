---
import { getStaticPathsHelper } from '@/i18n/paths-helper';
import PageLayout from '@/layouts/PageLayout.astro';
import { useTranslations } from '@/i18n/index';
import type { Locale } from '@/i18n/config';
import Button from '@/components/ui/form/Button/Button.astro';

export const getStaticPaths = getStaticPathsHelper;

const { lang } = Astro.params;
const locale = lang as Locale;
const t = useTranslations(locale);
---

<PageLayout title={t('contact.meta.title')} description={t('contact.meta.description')}>
  <section class="py-24 md:py-32">
    <div class="container mx-auto px-4 text-center max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl font-display text-balance">
        {t('contact.hero.title')}
      </h1>
      <p class="text-lg text-muted-foreground leading-relaxed text-balance mx-auto max-w-2xl mt-10">
        {t('contact.free.description')}
      </p>
      <Button variant="primary" size="lg" href={t('contact.free.url')} class="mt-10">
        {t('contact.free.button')}
      </Button>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-muted/50">
    <div class="container mx-auto px-4 max-w-3xl text-center">
      <h2 class="text-2xl font-bold font-display mb-4">{t('contact.paid.title')}</h2>
      <p class="text-muted-foreground leading-relaxed max-w-2xl mx-auto mb-8">
        {t('contact.paid.description')}
      </p>
      <Button variant="outline" size="lg" href={t('contact.paid.url')}>
        {t('contact.paid.button')}
      </Button>
    </div>
  </section>
</PageLayout>
