---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogLayout from '@/layouts/BlogLayout.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { createBlogPostSchema, createWebPageSchema } from '@/lib/schema';
import { defaultLocale, locales, type Locale } from '@/i18n/config';
import siteConfig from '@/config/site.config';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('articles', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  const paths = [];
  for (const locale of locales) {
    for (const entry of entries) {
      // Each post is generated only for its own locale: the blog is
      // English-only until German translations are published.
      if ((entry.data.locale || defaultLocale) !== locale) continue;
      paths.push({
        params: { lang: locale, slug: entry.id },
        props: { entry, locale },
      });
    }
  }
  return paths;
};

const { locale, entry } = Astro.props as { locale: Locale; entry: CollectionEntry<'articles'> };
const { Content } = await render(entry);
const wordCount = entry.body?.split(/\s+/).filter(Boolean).length ?? 0;

const canonicalUrl = new URL(`/${locale}/blog/${entry.id}/`, siteConfig.url);

// og:image source — SVG heroes are excluded: Facebook/X/LinkedIn do not
// render SVG, so (as in SEO.astro) they fall back to the generated PNG for
// this article. The visible hero <img> keeps the original asset.
const dynamicOgImage = `/og/${locale}/blog/${entry.id}.png`;
const heroIsSvg = entry.data.image
  ? /\.svg$/i.test(
      (typeof entry.data.image === 'string' ? entry.data.image : entry.data.image.src).split(
        /[?#]/
      )[0]
    )
  : false;
const ogImage =
  entry.data.image && !heroIsSvg
    ? typeof entry.data.image === 'string'
      ? entry.data.image
      : entry.data.image.src
    : dynamicOgImage;

// The generated card shows the title/description, not the hero artwork, so
// its alt text is the full title; SVG-hero articles keep their hero alt for
// the hero <img> but must not describe the SVG in the og:image meta.
const ogImageGenerated = ogImage === dynamicOgImage;
const ogImageAlt = ogImageGenerated ? entry.data.title : undefined;

// Publishing principles — locale-specific About-page editorial-standards
// anchor. Trailing slash before the hash so it matches the About canonical
// (the slash-less form 301-hops through the redirect shims).
const publishingPrinciples = new URL(
  `/${locale}/about/#editorial-standards`,
  siteConfig.url
).toString();

// Reviewer URL — trailing slash so it matches the About page canonical
// (the slash-less `/en/about` 301-hops through the redirect shims).
const reviewedByUrl = new URL(`/${locale}/about/`, siteConfig.url).toString();

// An explicit hero caption wins; AI-generated images fall back to the
// provenance disclosure so the disclosure is always rendered.
const heroCaption = entry.data.heroCaption ?? entry.data.imageProvenance?.disclosure;

// Caption/credit are only attached to images whose provenance is recorded.
const imageCaption = entry.data.imageProvenance ? heroCaption : undefined;
const imageCredit = entry.data.imageProvenance ? entry.data.author : undefined;
---

<BlogLayout
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={entry.data.description}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  author={entry.data.author}
  ogImage={ogImage}
  ogImageGenerated={ogImageGenerated}
  ogImageAlt={ogImageAlt}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  heroCaption={heroCaption}
  wordCount={wordCount}
  tags={entry.data.tags}
  slug={entry.id}
  locale={locale}
>
  <JsonLd
    schema={[
      createBlogPostSchema({
        title: entry.data.title,
        description: entry.data.description,
        url: canonicalUrl.toString(),
        image: new URL(ogImage, siteConfig.url).toString(),
        datePublished: entry.data.publishedAt,
        dateModified: entry.data.updatedAt || entry.data.publishedAt,
        author: { name: entry.data.author },
        publishingPrinciples,
        imageCaption,
        imageCredit,
      }),
      createWebPageSchema({
        url: canonicalUrl.toString(),
        reviewedBy: {
          name: entry.data.author,
          url: reviewedByUrl,
        },
        publishingPrinciples,
      }),
    ]}
  />

  <Content />
</BlogLayout>
