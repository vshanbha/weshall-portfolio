---
import PageLayout from '@/layouts/PageLayout.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getLocalizedPath, useTranslations } from '@/i18n/index';
import { defaultLocale, locales, isValidLocale } from '@/i18n/config';
import type { Locale } from '@/i18n/config';
import type { GetStaticPaths } from 'astro';

// The index is generated for every active locale, so /de/blog serves German
// chrome. Posts stay English-only until locale-tagged content exists (see
// englishOnlyDetailRoutes in src/i18n/routes.ts).
export const getStaticPaths: GetStaticPaths = async () =>
  locales.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;
const locale = lang as Locale;
const t = useTranslations(locale);

const allEntries = await getCollection('articles', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

// Posts written for this page's locale.
const localeEntries = allEntries.filter((e) => {
  const articleLocale = e.data.locale || defaultLocale;
  return articleLocale === locale;
});

// A non-default locale also lists the default-locale posts — they are the only
// published ones — each linking to its English detail page.
const englishEntries =
  locale === defaultLocale
    ? []
    : allEntries.filter((e) => (e.data.locale || defaultLocale) === defaultLocale);

const byPriority = (a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
};

// Detail URLs follow each entry's content locale, narrowed to the locales the
// site builds (the content schema also allows dormant ones).
const detailLocale = (entry: CollectionEntry<'articles'>): Locale => {
  const entryLocale = entry.data.locale ?? defaultLocale;
  return isValidLocale(entryLocale) ? entryLocale : defaultLocale;
};

type BlogGroup = {
  entries: CollectionEntry<'articles'>[];
  /** Honest note rendered above the English group on a localised index. */
  notice?: string;
  hrefFor: (entry: CollectionEntry<'articles'>) => string;
};

const groups: BlogGroup[] = [];
if (localeEntries.length > 0) {
  groups.push({
    entries: localeEntries.sort(byPriority),
    hrefFor: (entry) => `/${locale}/blog/${entry.id}/`,
  });
}
if (englishEntries.length > 0) {
  groups.push({
    entries: englishEntries.sort(byPriority),
    // Owner-approved wording for the German index.
    notice:
      locale === defaultLocale
        ? undefined
        : 'Hinweis: Der Blog ist bis auf Weiteres nur auf Englisch.',
    hrefFor: (entry) => `${getLocalizedPath('blog', detailLocale(entry))}/${entry.id}/`,
  });
}
---

<PageLayout title={t('blog.title')} description={t('blog.description')}>
  <section class="py-24 md:py-32">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl text-center">
        {t('blog.title')}
      </h1>
      <p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto text-center">
        {t('blog.description')}
      </p>

      {groups.length > 0 ? (
        groups.map((group) => (
          <>
            {group.notice && (
              <p class="mt-12 rounded-lg border border-border bg-muted/50 px-4 py-3 text-sm text-muted-foreground">
                {group.notice}
              </p>
            )}
            <div
              class={
                group.notice
                  ? 'mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3'
                  : 'mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3'
              }
            >
              {group.entries.map((entry) => (
                <BlogCard
                  title={entry.data.title}
                  description={entry.data.description}
                  href={group.hrefFor(entry)}
                  publishedAt={entry.data.publishedAt}
                  tags={entry.data.tags}
                  author={entry.data.author}
                  image={entry.data.image}
                  featured={entry.data.featured}
                  wordCount={entry.body?.split(/\s+/).filter(Boolean).length ?? 0}
                />
              ))}
            </div>
          </>
        ))
      ) : (
        <p class="mt-16 text-center text-muted-foreground">{t('blog.noPosts')}</p>
      )}
    </div>
  </section>
</PageLayout>
