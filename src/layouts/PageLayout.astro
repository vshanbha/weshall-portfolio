---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer for consistent navigation
 * Used when demo content is not included
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import siteConfig from '@/config/site.config';
import { getLocaleFromPath, localePath } from '@/i18n/config';
import { useTranslations } from '@/i18n/index';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const { title, description, image, imageAlt, noindex, nofollow } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
>
  <Header
    slot="header"
    showCta
    cta={{ label: t('hero.cta.primary'), href: siteConfig.bookingUrl }}
  />

  <div class="min-h-screen pt-16">
    <slot />
  </div>

  <Footer
    slot="footer"
    layout="stacked"
    legalLinks={[
      { label: 'Impressum', href: localePath('/impressum', locale) },
      { label: 'Datenschutz', href: localePath('/datenschutz', locale) },
    ]}
  />
</BaseLayout>
