---
import { cn } from '@/lib/cn';
import JsonLd from './JsonLd.astro';
import { createBreadcrumbSchema } from '@/lib/schema';
import siteConfig from '@/config/site.config';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;

// Build schema items with full URLs. Item URLs are trailing-slashed so they
// match the page canonicals: the slash-less form 301-hops before resolving,
// and JSON-LD should state the canonical URL verbatim (a hash, if any, is
// preserved — only the pathname is normalised).
function toCanonicalUrl(href: string): string {
  const url = new URL(href, siteConfig.url);
  if (!url.pathname.endsWith('/')) url.pathname += '/';
  return url.toString();
}

const schemaItems = items.map((item) => ({
  name: item.label,
  url: toCanonicalUrl(item.href ?? Astro.url.pathname),
}));

const schema = createBreadcrumbSchema(schemaItems);
---

<JsonLd schema={schema} />

<nav aria-label="Breadcrumb" class={cn('text-sm', className)}>
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && (
          <svg
            class="h-4 w-4 text-muted-foreground"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            />
          </svg>
        )}
        {item.href && index !== items.length - 1 ? (
          <a href={item.href} class="text-muted-foreground hover:text-foreground transition-colors">
            {item.label}
          </a>
        ) : (
          <span
            class="text-foreground font-medium"
            aria-current={index === items.length - 1 ? 'page' : undefined}
          >
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
