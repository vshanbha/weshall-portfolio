---
import Button from '@/components/ui/form/Button/Button.astro';

export interface Props {
  locale: string;
  /** Translation object containing hero section strings */
  t: {
    title: string;
    bridge: string;
    cta: {
      primary: string;
      secondary: string;
    };
    rightColumn: {
      name: string;
      statement: string;
      also: string;
      aboutLink: string;
    };
  };
}

const { locale, t } = Astro.props;
---

<section class="py-[var(--space-section-xl)] bg-background">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
      <div class="flex-1 lg:flex-[1.2]">
        <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-balance text-foreground mb-4">
          {t.title}
        </h1>
        <p class="text-lg md:text-xl text-foreground-muted mb-8 max-w-2xl">{t.bridge}</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button variant="primary" size="lg" href={`/${locale}/contact`}>
            {t.cta.primary}
          </Button>
          <Button variant="outline" size="lg" href={`/${locale}/blog`}>
            {t.cta.secondary}
          </Button>
        </div>
      </div>

      <div class="w-full lg:w-auto lg:flex-[0.8] lg:min-w-[280px]">
        <div class="bg-muted rounded-xl p-7 space-y-4">
          <div class="font-sans text-sm text-foreground-muted leading-relaxed">
            <strong class="font-display text-base font-semibold text-foreground">
              {t.rightColumn.name}
            </strong>{' '}
            {t.rightColumn.statement}
          </div>
          <div class="font-sans text-sm text-foreground-muted leading-relaxed">
            {t.rightColumn.also}
          </div>
          <div class="pt-2">
            <a
              href={`/${locale}/about`}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 dark:text-brand-300 bg-accent/10 hover:bg-accent/20 rounded-full px-4 py-1.5 transition-colors"
            >
              {t.rightColumn.aboutLink} →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
